# ============================================================
# LegalMind AI — Environment Variables Example
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ─────────────────────────────────────────
# NODE.JS / EXPRESS — Main Application Backend
# ─────────────────────────────────────────
NODE_ENV=development
PORT=5001

# MongoDB Connection (via Docker)
MONGODB_URI=mongodb://admin:password123@localhost:27018/legalmind?authSource=admin

# JWT Secret — change this to a long random string in production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# AI Service URL — FastAPI service base URL
AI_SERVICE_URL=http://localhost:8000

# Internal API Key — shared secret between Node.js and FastAPI
INTERNAL_API_KEY=internal_secret_key_change_this

# ─────────────────────────────────────────
# PYTHON / FASTAPI — AI / Document Processing Service
# ─────────────────────────────────────────
FASTAPI_PORT=8000

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# FAISS Index Storage Path
FAISS_INDEX_PATH=../faiss_indexes

# Uploaded Files Storage Path
UPLOAD_DIR=../storage

# ─────────────────────────────────────────
# MONGODB (Docker)
# ─────────────────────────────────────────
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password123
MONGO_DATABASE=legalmind

# ─────────────────────────────────────────
# FRONTEND (React)
# ─────────────────────────────────────────
REACT_APP_API_URL=http://localhost:5001/api