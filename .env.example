# ============================================================
# LegalMind AI — Environment Variables Example
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ─────────────────────────────────────────
# NODE.JS / EXPRESS — Main Application Backend
# ─────────────────────────────────────────
NODE_ENV=
PORT=

# MongoDB Connection (via Docker)
MONGODB_URI=

# JWT Secret — change this to a long random string in production
JWT_SECRET=
JWT_EXPIRES_IN=

# AI Service URL — FastAPI service base URL
AI_SERVICE_URL=

# Internal API Key — shared secret between Node.js and FastAPI
INTERNAL_API_KEY=

# ─────────────────────────────────────────
# PYTHON / FASTAPI — AI / Document Processing Service
# ─────────────────────────────────────────
FASTAPI_PORT=

# Gemini API Key
GEMINI_API_KEY=
# Gemini Model Name (configurable; defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# FAISS Index Storage Path
FAISS_INDEX_PATH=
# FAISS In-Memory LRU Cache Max Size (default: 20)
FAISS_CACHE_MAX_SIZE=20

# Uploaded Files Storage Path
UPLOAD_DIR=

# ─────────────────────────────────────────
# MONGODB (Docker)
# ─────────────────────────────────────────
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_DATABASE=

# ─────────────────────────────────────────
# FRONTEND (React)
# ─────────────────────────────────────────
REACT_APP_API_URL=