# ========================
# LegalMind AI — .gitignore
# ========================

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/

# React build
frontend/build/
frontend/dist/

# FAISS indexes
faiss_indexes/*.index
faiss_indexes/*.pkl

# Uploaded files
storage/*
!storage/.gitkeep

# Reports
reports/*
!reports/.gitkeep

# Logs
logs/
*.log

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V4
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker volumes
mongo_data/


# Generated reports
backend/node-server/src/utils/downloaded-report-*.pdf

# Generated vector indexes
faiss_indexes/*
!faiss_indexes/.gitkeep